---
// Rejilla de tarjetas con ilustración que enlazan a otra página (servicios o casos).
import { Image } from 'astro:assets';
import type { Pic } from '@data/services';

export interface Card {
  href: string;
  title: string;
  text: string;
  img: Pic;
  /** Texto del enlace si difiere del de la rejilla */
  linkLabel?: string;
}

interface Props {
  cards: Card[];
  linkLabel?: string;
}
const { cards, linkLabel = 'Ver más →' } = Astro.props;
---

<div class="cg">
  {cards.map((card) => (
    <a href={card.href} class="cg-card">
      <div class="cg-visual">
        <Image src={card.img.src} alt={card.img.alt} height={150} densities={[1, 2]} class="cg-img" loading="lazy" decoding="async" style={card.img.scale ? `transform: scale(${card.img.scale});` : undefined} />
      </div>
      <h3 class="cg-title">{card.title}</h3>
      <p class="cg-text">{card.text}</p>
      <span class="cg-link">{card.linkLabel ?? linkLabel}</span>
    </a>
  ))}
</div>

<style>
  .cg {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
  }
  .cg-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 0 8px 16px;
    text-align: center;
    color: #111827;
    text-decoration: none;
    transition: transform 0.3s;
  }
  .cg-card:hover { transform: translateY(-3px); }
  .cg-visual {
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cg-img {
    display: block;
    height: 150px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  .cg-title {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
  }
  .cg-text {
    font-size: 15px;
    line-height: 1.6;
    color: #6b7280;
  }
  .cg-link {
    margin-top: auto;
    font-size: 15.5px;
    font-weight: 500;
    color: #16a34a;
  }
</style>
