---
import Highlight from './Highlight.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** max-width del bloque, en px */
  width?: number;
  class?: string;
}
const { eyebrow, title, lead, width = 760, class: className } = Astro.props;
---

<div class:list={['sh', className]} style={`max-width: ${width}px;`}>
  {eyebrow && <p class="sh-eyebrow">{eyebrow}</p>}
  <h2 class="sh-title"><Highlight text={title} /></h2>
  {lead && <p class="sh-lead">{lead}</p>}
  <slot />
</div>

<style>
  .sh-eyebrow {
    margin-bottom: 16px;
    color: #22c55e;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .sh-title {
    margin-bottom: 20px;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #0f172a;
  }
  .sh-lead {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.65;
    color: #64748b;
    text-wrap: pretty;
  }
</style>
