---
import { Image } from 'astro:assets';
import logoImg from '@assets/icons/Logo.webp';

import gestionadaImg from '@assets/mascota-proteccion-gestionada.webp';
import detectiveImg from '@assets/detective.webp';
import { servicesIn, serviceHref } from '@data/services';

// Navegación por público. Las anclas apuntan a secciones de la home.
const auditServices = servicesIn('auditoria').map((s) => ({ label: s.name, href: serviceHref(s.slug) }));
const mobileLinks = [
  { label: 'Ciberseguridad', href: '/ciberseguridad', sub: [
    { label: 'Ciberseguridad gestionada', href: '/ciberseguridad/gestionada', strong: true },
    { label: 'Auditoría y pruebas', href: '/ciberseguridad#auditoria' },
    { label: 'Formación', href: '/ciberseguridad/concienciacion-phishing' },
  ] },
  { label: 'Ciberinteligencia', href: '/ciberinteligencia', sub: [
    { label: 'Investigación OSINT', href: '/ciberinteligencia', strong: true },
  ] },
  { label: 'Partners', href: '/#partners' },
  { label: 'Equipo', href: '/#equipo' },
  { label: 'Blog', href: '/#blog' },
];
// En la home abren el formulario (data-open lo gestiona LeadModals); en el resto llevan a la home con el hash
const contactOptions = [
  { title: 'Quiero proteger mi empresa', text: 'Ciberseguridad gestionada, auditoría y pentesting', href: '/#solicitar-auditoria', open: 'auditoria' },
  { title: 'Tengo un caso para investigar', text: 'Investigación digital OSINT', href: '/#contar-caso', open: 'osint' },
  { title: 'Quiero ser partner', text: 'MSSP, consultora o despacho', href: '/#ser-partner', open: 'partner' },
];
---

<!-- Announcement Bar -->
<div
  id="announcement-bar"
  style="position: fixed; top: 0; left: 0; right: 0; z-index: 55; background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%); color: #fff; transition: transform 0.3s ease; overflow: hidden;"
>
  <div class="container-custom flex items-center justify-center relative" style="height: 44px;">
    <a
      href="https://wa.me/34603358517?text=Hola%2C%20quiero%20un%20reconocimiento%20de%20huella%20digital" data-ref="WEB-BANNER"
      target="_blank"
      rel="noopener noreferrer"
      class="announcement-link"
    >
      <span class="announcement-full">Descubre gratis qué saben los hackers de tu empresa</span>
      <span class="announcement-short">¿Tu empresa es segura?</span>
      <span class="announcement-pipe" aria-hidden="true">|</span>
      <span class="announcement-cta">Huella digital gratuita</span>
    </a>
    <button
      id="announcement-close"
      class="announcement-close-btn"
      aria-label="Cerrar anuncio"
    >
      <svg style="width: 16px; height: 16px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<header
  id="main-header"
  class="fixed left-0 right-0 z-50 transition-all duration-300"
  style="top: 44px;"
  data-transparent
>
  <nav class="container-custom" aria-label="Navegación principal">
    <div class="flex items-center justify-between h-14 lg:h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label="GreenLock - Inicio">
        <Image src={logoImg} alt="GreenLock" width={40} height={40} class="w-10 h-10 object-contain" loading="eager" />
        <span class="text-lg font-bold header-logo-text text-dark-900 transition-colors duration-300">
          Green<span class="text-brand-500 header-logo-accent transition-colors duration-300">Lock</span>
        </span>
      </a>

      <!-- Desktop Navigation: desplegables con :hover y :focus-within -->
      <div class="hidden lg:flex items-center gap-1">
        <div class="nav-dd">
          <a href="/ciberseguridad" class="header-nav-link nav-dd-trigger px-3 py-1.5 text-xs font-medium rounded-md transition-colors uppercase tracking-wider text-dark-700 hover:text-dark-900" aria-haspopup="true" data-door="empresa">
            Ciberseguridad<span class="nav-caret" aria-hidden="true">▾</span>
          </a>
          <div class="nav-dd-panel nav-dd-panel--wide">
            <div class="nav-dd-box nav-dd-grid">
              <div class="nav-dd-col">
                <span class="nav-dd-label">Ciberseguridad gestionada</span>
                <a href="/ciberseguridad/gestionada" class="nav-dd-feature">
                  <Image src={gestionadaImg} alt="" height={110} densities={[1, 2]} class="nav-dd-feature-img" loading="lazy" decoding="async" />
                  <span class="nav-dd-feature-title">Ciberseguridad gestionada</span>
                  <span class="nav-dd-feature-text">Nos ocupamos de tu ciberseguridad a medida. Recomendado para pymes.</span>
                </a>
              </div>
              <div class="nav-dd-col">
                <span class="nav-dd-label">Auditoría y pruebas</span>
                {auditServices.map((s) => <a href={s.href} class="nav-dd-link">{s.label}</a>)}
              </div>
              <div class="nav-dd-col">
                <span class="nav-dd-label">Formación</span>
                <a href="/ciberseguridad/concienciacion-phishing" class="nav-dd-link">
                  Concienciación y phishing simulado
                  <span class="nav-dd-link-text">Formamos a tu equipo y lo ponemos a prueba.</span>
                </a>
                <a href="/ciberseguridad" class="nav-dd-all">Ver todos los servicios →</a>
              </div>
            </div>
          </div>
        </div>
        <div class="nav-dd">
          <a href="/ciberinteligencia" class="header-nav-link nav-dd-trigger px-3 py-1.5 text-xs font-medium rounded-md transition-colors uppercase tracking-wider text-dark-700 hover:text-dark-900" aria-haspopup="true" data-door="caso">
            Ciberinteligencia<span class="nav-caret" aria-hidden="true">▾</span>
          </a>
          <div class="nav-dd-panel">
            <div class="nav-dd-box nav-dd-box--narrow">
              <a href="/ciberinteligencia" class="nav-dd-feature nav-dd-feature--row">
                <Image src={detectiveImg} alt="" height={56} densities={[1, 2]} class="nav-dd-feature-icon" loading="lazy" decoding="async" />
                <span class="nav-dd-feature-body">
                  <span class="nav-dd-feature-title">Investigación OSINT</span>
                  <span class="nav-dd-feature-text">Seguimos el rastro digital y lo convertimos en prueba.</span>
                </span>
              </a>
            </div>
          </div>
        </div>
        {mobileLinks.slice(2).map((link) => (
          <a
            href={link.href}
            class="header-nav-link px-3 py-1.5 text-xs font-medium rounded-md transition-colors uppercase tracking-wider text-dark-700 hover:text-dark-900"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA + Mobile Toggle -->
      <div class="flex items-center gap-3">
        <div class="contact-dd hidden sm:block">
          <button
            type="button"
            id="contact-toggle"
            class="relative inline-flex items-center gap-2 px-6 py-2.5 rounded-none font-semibold text-sm uppercase tracking-wider transition-all header-cta-btn"
            style="background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); border: none; color: #fff;"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="contact-menu"
          >
            <!-- Anillo pulsante: lo activa LeadModals (clase is-pulsing) al aparecer la mascota de partners -->
            <span class="header-cta-ring" aria-hidden="true"></span>
            Contactar<span class="nav-caret" aria-hidden="true">▾</span>
          </button>
          <div id="contact-menu" class="contact-menu" role="menu" hidden>
            {contactOptions.map((o) => (
              <a href={o.href} data-open={o.open} role="menuitem" class="contact-item">
                <span class="contact-item-title">{o.title}</span>
                <span class="contact-item-text">{o.text}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Hamburger button -->
        <button
          id="mobile-menu-toggle"
          class="lg:hidden flex items-center justify-center w-9 h-9 rounded-lg text-dark-700 hover:bg-dark-100 transition-colors header-hamburger"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] bg-white transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <!-- Mobile menu top bar -->
  <div class="flex items-center justify-between h-11 px-6 border-b border-dark-100">
    <a href="/" class="flex items-center gap-2" aria-label="GreenLock - Inicio">
      <Image src={logoImg} alt="GreenLock" width={32} height={32} class="w-8 h-8 object-contain" />
      <span class="text-xl font-bold text-dark-900">Green<span class="text-brand-500">Lock</span></span>
    </a>
    <button
      id="mobile-menu-close"
      class="flex items-center justify-center w-10 h-10 rounded-lg text-dark-700 hover:bg-dark-50 transition-colors"
      aria-label="Cerrar menú"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile navigation links -->
  <div class="px-4 py-4 pb-32">
    {mobileLinks.map((link) => (
      <>
        <a
          href={link.href}
          class="block py-4 px-2 text-base font-medium uppercase tracking-wider border-b border-dark-100 text-dark-900 hover:text-brand-600 transition-colors"
        >
          {link.label}
        </a>
        {link.sub?.map((sub) => (
          <a
            href={sub.href}
            class:list={['block py-3 pl-6 pr-2 text-base border-b border-dark-100 transition-colors', sub.strong ? 'font-medium mobile-sub-strong' : 'text-dark-600 hover:text-brand-600']}
          >
            {sub.label}
          </a>
        ))}
      </>
    ))}
  </div>

  <!-- Mobile CTA fixed bottom -->
  <div class="fixed bottom-0 left-0 right-0 p-4 bg-white border-t border-dark-100 lg:hidden">
    <a
      href="https://wa.me/34603358517?text=Hola%2C%20me%20gustar%C3%ADa%20solicitar%20informaci%C3%B3n%20sobre%20vuestros%20servicios%20de%20ciberseguridad" data-ref="WEB-MOBILE"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center w-full px-6 py-3 rounded-lg font-semibold transition-colors text-white"
      style="background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);"
    >
      Contáctanos
    </a>
  </div>
</div>

<!-- Spacer for non-home pages where header is solid -->
<div id="header-spacer" class="h-24 lg:h-26"></div>

<script>
  function initHeader() {
    const header = document.getElementById('main-header');
    const spacer = document.getElementById('header-spacer');
    const overlayHeroPaths = ['/'];
    const isHome = overlayHeroPaths.includes(window.location.pathname);

    if (!header) return;

    const navLinks = header.querySelectorAll('.header-nav-link');
    const logoText = header.querySelector('.header-logo-text') as HTMLElement | null;
    const logoAccent = header.querySelector('.header-logo-accent') as HTMLElement | null;
    const hamburger = header.querySelector('.header-hamburger') as HTMLElement | null;

    function setSolid() {
      header!.removeAttribute('data-transparent');
      header!.classList.add('bg-white/95', 'backdrop-blur-xl', 'shadow-sm');
      navLinks.forEach(link => {
        link.classList.remove('text-white', 'hover:text-white');
        link.classList.add('text-dark-700', 'hover:text-dark-900');
      });
      if (logoText) { logoText.classList.remove('text-white'); logoText.classList.add('text-dark-900'); }
      if (logoAccent) { logoAccent.classList.remove('text-brand-400'); logoAccent.classList.add('text-brand-500'); }
      if (hamburger) { hamburger.classList.remove('text-white'); hamburger.classList.add('text-dark-700'); }
    }

    if (isHome) {
      if (spacer) spacer.style.display = 'none';
      function onScrollHome() {
        if (window.scrollY > 20) {
          setSolid();
        } else {
          header!.setAttribute('data-transparent', '');
          header!.classList.remove('bg-white/95', 'backdrop-blur-xl', 'shadow-sm');
        }
      }
      window.removeEventListener('scroll', (window as any).__headerScrollFn);
      (window as any).__headerScrollFn = onScrollHome;
      window.addEventListener('scroll', onScrollHome, { passive: true });
      onScrollHome();
    } else {
      if (spacer) spacer.style.display = '';
      if ((window as any).__headerScrollFn) {
        window.removeEventListener('scroll', (window as any).__headerScrollFn);
        (window as any).__headerScrollFn = null;
      }
      setSolid();
    }

    // Announcement bar
    const announcementBar = document.getElementById('announcement-bar');
    const announcementClose = document.getElementById('announcement-close');
    let announcementDismissed = localStorage.getItem('announcement-dismissed') === '1';
    let announcementHidden = false;

    function hideAnnouncement() {
      if (announcementHidden) return;
      announcementHidden = true;
      if (announcementBar) announcementBar.style.transform = 'translateY(-100%)';
      if (header) header.style.top = '0';
    }

    function showAnnouncement() {
      if (!announcementHidden || announcementDismissed) return;
      announcementHidden = false;
      if (announcementBar) announcementBar.style.transform = 'translateY(0)';
      if (header) header.style.top = '44px';
    }

    function dismissAnnouncement() {
      announcementDismissed = true;
      hideAnnouncement();
      localStorage.setItem('announcement-dismissed', '1');
    }

    announcementClose?.addEventListener('click', dismissAnnouncement);

    if (!announcementDismissed) {
      function onScrollAnnounce() {
        if (window.scrollY > 20) { hideAnnouncement(); }
        else { showAnnouncement(); }
      }
      window.removeEventListener('scroll', (window as any).__announceScrollFn);
      (window as any).__announceScrollFn = onScrollAnnounce;
      window.addEventListener('scroll', onScrollAnnounce, { passive: true });
    } else {
      hideAnnouncement();
    }

    // Mobile menu
    const mobileMenu = document.getElementById('mobile-menu');
    const menuToggle = document.getElementById('mobile-menu-toggle');
    const menuClose = document.getElementById('mobile-menu-close');

    function openMenu() {
      mobileMenu?.classList.remove('translate-x-full');
      mobileMenu?.classList.add('translate-x-0');
      menuToggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      menuClose?.focus();
    }

    function closeMenu() {
      mobileMenu?.classList.remove('translate-x-0');
      mobileMenu?.classList.add('translate-x-full');
      menuToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    menuToggle?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
    mobileMenu?.querySelectorAll('a').forEach((link) => { link.addEventListener('click', closeMenu); });

    // Ensure mobile menu is closed after navigation
    closeMenu();

    // Menú «Contactar»: las opciones abren el formulario en la home o llevan a ella con el hash
    const contactToggle = document.getElementById('contact-toggle');
    const contactMenu = document.getElementById('contact-menu');
    const setContact = (openMenu: boolean) => {
      if (!contactMenu || !contactToggle) return;
      contactMenu.hidden = !openMenu;
      contactToggle.setAttribute('aria-expanded', String(openMenu));
    };
    contactToggle?.addEventListener('click', () => setContact(!!contactMenu?.hidden));
    contactMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setContact(false)));
    (window as any).__contactAbort?.abort();
    const contactAbort = new AbortController();
    (window as any).__contactAbort = contactAbort;
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.contact-dd')) setContact(false);
    }, { signal: contactAbort.signal });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setContact(false); }, { signal: contactAbort.signal });
  }

  // Run on initial load
  initHeader();
  // Re-run after View Transitions swap (client-side navigation)
  document.addEventListener('astro:after-swap', initHeader);
</script>

<!-- Smooth scroll + offset para que las anclas no queden bajo el header fijo -->
<style is:global>
  html { scroll-behavior: smooth; }
  #servicios, #osint, #casos, #equipo, #blog, #partners, #contacto, #auditoria { scroll-margin-top: 100px; }
</style>

<style>
  .announcement-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 400;
    color: #fff;
    text-decoration: none;
    transition: opacity 0.2s;
    white-space: nowrap;
  }
  .announcement-link:hover { opacity: 0.85; }
  .announcement-pipe { opacity: 0.6; }
  .announcement-cta {
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .announcement-close-btn {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    padding: 6px;
    color: rgba(255,255,255,0.7);
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.2s;
  }
  .announcement-close-btn:hover { color: #fff; }
  .announcement-short { display: none; }

  /* ---- Desplegables del menú (escritorio) ---- */
  .nav-dd { position: relative; }
  .nav-dd-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .nav-caret { font-size: 9px; }
  .nav-dd-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 80;
    padding-top: 18px;
    transform: translateX(-50%);
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.18s ease, visibility 0.18s;
  }
  .nav-dd-panel--wide { transform: translateX(-38%); }
  .nav-dd:hover .nav-dd-panel,
  .nav-dd:focus-within .nav-dd-panel {
    visibility: visible;
    opacity: 1;
  }
  .nav-dd-box {
    background: #fff;
    border: 1px solid #e5e7eb;
    box-shadow: 0 30px 60px -24px rgba(15, 23, 42, 0.3);
  }
  .nav-dd-grid {
    display: grid;
    grid-template-columns: 1.1fr 1.3fr 1fr;
    gap: 28px;
    width: min(760px, calc(100vw - 48px));
    padding: 26px 28px;
  }
  .nav-dd-box--narrow {
    width: 280px;
    padding: 14px;
  }
  .nav-dd-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .nav-dd-label {
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #16a34a;
  }
  .nav-dd-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0 -12px;
    padding: 10px 12px;
    font-size: 15px;
    font-weight: 500;
    color: #111827;
    text-decoration: none;
    transition: background 0.2s;
  }
  .nav-dd-link:hover { background: #f0fdf4; }
  .nav-dd-link-text {
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    color: #64748b;
  }
  .nav-dd-all {
    margin-top: auto;
    padding-top: 18px;
    font-size: 14px;
    font-weight: 500;
    color: #16a34a;
    text-decoration: none;
  }
  .nav-dd-all:hover { color: #15803d; }
  .nav-dd-feature {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    background: #f0fdf4;
    color: #111827;
    text-decoration: none;
    transition: background 0.2s;
  }
  .nav-dd-feature:hover { background: #dcfce7; }
  .nav-dd-feature--row {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    padding: 12px;
  }
  .nav-dd-feature-img {
    width: 100%;
    height: 110px;
    object-fit: contain;
  }
  .nav-dd-feature-icon {
    flex: none;
    width: 56px;
    height: 56px;
    object-fit: contain;
  }
  .nav-dd-feature-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .nav-dd-feature-title {
    font-size: 16px;
    font-weight: 700;
  }
  .nav-dd-feature-text {
    font-size: 13px;
    line-height: 1.45;
    color: #475569;
  }

  /* ---- Menú «Contactar» ---- */
  .contact-dd { position: relative; }
  .contact-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 80;
    width: min(300px, calc(100vw - 32px));
    background: #fff;
    border: 1px solid #e5e7eb;
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.35);
    animation: glPop 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
    border-bottom: 1px solid #f3f4f6;
    text-decoration: none;
    transition: background 0.2s;
  }
  .contact-item:last-child { border-bottom: 0; }
  .contact-item:hover { background: #f0fdf4; }
  .contact-item-title {
    font-size: 15.5px;
    font-weight: 700;
    color: #111827;
  }
  .contact-item-text {
    font-size: 13.5px;
    color: #64748b;
  }

  .mobile-sub-strong { color: #16a34a; }

  .header-cta-ring {
    display: none;
    position: absolute;
    inset: 0;
    border: 2px solid #22c55e;
    pointer-events: none;
    animation: glRing 1.6s ease-out infinite;
  }
  .header-cta-btn.is-pulsing .header-cta-ring { display: block; }
  @media (prefers-reduced-motion: reduce) {
    .header-cta-ring { animation: none; }
  }

  @media (max-width: 640px) {
    .announcement-link {
      font-size: 12px;
      gap: 5px;
      white-space: normal;
    }
    .announcement-full { display: none; }
    .announcement-short { display: inline; }
    .announcement-close-btn { right: 4px; padding: 4px; }
  }
</style>
