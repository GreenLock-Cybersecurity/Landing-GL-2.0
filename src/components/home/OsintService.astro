---
import { Image } from 'astro:assets';
import estafadorImg from '@assets/estafador.webp';
import marcaImg from '@assets/marca.webp';
import detectiveImg from '@assets/detective.webp';
import complianceImg from '@assets/partner-compliance.webp';

// Legal: GreenLock no tiene licencia de detective. Esa palabra no puede
// aparecer en ningún texto visible ni en los alt (el nombre de archivo sí).
// Cada tarjeta abre el formulario de investigación con su caso ya marcado
// (data-opt = índice en LEAD_OPTIONS.osint).
const items = [
  { title: 'Estafas y fraude online', desc: 'Tiendas falsas, inversiones fraudulentas o falsos bancos.', img: estafadorImg },
  { title: 'Suplantación de marca o identidad', desc: 'Alguien usa tu marca, tu web o tu nombre.', img: marcaImg },
  { title: 'Acoso desde cuentas anónimas', desc: 'Te insultan, amenazan o difaman sin dar la cara.', img: detectiveImg },
  { title: 'Pruebas para un juicio', desc: 'Evidencia digital documentada para denunciar o ir a juicio.', img: complianceImg, scale: 1.5 },
];

const ctaHref =
  'https://wa.me/34603358517?text=Hola%2C%20quiero%20contaros%20mi%20caso%20(investigaci%C3%B3n)';
---

<section id="osint" class="os">
  <div class="container-custom section-padding">

    <div class="mb-16 max-w-3xl">
      <p class="uppercase mb-4" style="color: #22c55e; font-size: clamp(1.25rem, 2.4vw, 1.625rem); font-weight: 700; letter-spacing: 0.04em;">
        Ciberinteligencia · Investigación OSINT
      </p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark-900 mb-5 leading-tight">
        Detrás de cada caso hay <span style="color: #22c55e;">un rastro.</span><br/>
        Lo seguimos y lo convertimos en <span style="color: #22c55e;">prueba.</span>
      </h2>
      <p class="text-lg text-dark-500 leading-relaxed">
        Investigamos con OSINT (inteligencia de fuentes abiertas) estafas, suplantaciones, cuentas anónimas o cualquier caso que necesite pruebas digitales, y te entregamos un informe pericial listo para tu abogado o tu denuncia.
      </p>
    </div>

    <div class="os-grid">
      {items.map((item, i) => (
        <button type="button" class="os-card" data-open="osint" data-opt={i}>
          <span class="os-visual">
            <Image src={item.img} alt={item.title} width={180} densities={[1, 2]} class="os-img" loading="lazy" decoding="async" style={item.scale ? `transform: scale(${item.scale});` : undefined} />
          </span>
          <span class="os-body">
            <span class="os-title">{item.title}</span>
            <span class="os-desc">{item.desc}</span>
            <span class="os-link">Es mi caso →</span>
          </span>
        </button>
      ))}
    </div>

    <div class="os-foot">
      <div class="os-foot-ctas">
        <button type="button" class="gl-btn-primary os-cta" data-open="osint" data-opt="0">
          Contar mi caso
        </button>
        <a href={ctaHref} data-ref="WEB-OSINT" target="_blank" rel="noopener noreferrer" class="gl-btn-ghost-green os-cta">
          Cuéntanoslo por WhatsApp
        </a>
      </div>
      <p class="os-foot-note">Confidencial · Te contactaremos en menos de 24 horas.</p>
      <a href="/ciberinteligencia" class="os-foot-link">Cómo funciona la investigación digital →</a>
    </div>

  </div>
</section>

<style>
  .os {
    background: #fff;
    border-top: 1px solid #eef0f2;
  }

  .os-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 24px;
  }

  .os-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    text-align: center;
    color: #111827;
    cursor: pointer;
    transition: transform 0.3s;
  }
  .os-card:hover { transform: translateY(-3px); }

  .os-visual {
    width: 100%;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 24px 16px;
  }
  .os-img {
    width: 180px;
    height: 180px;
    object-fit: contain;
  }

  .os-body {
    display: flex;
    flex-direction: column;
    padding: 0 16px 24px;
  }
  .os-title {
    margin-bottom: 10px;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
    color: #111827;
  }
  .os-desc {
    margin-bottom: 12px;
    font-size: 16.5px;
    line-height: 1.65;
    color: #6b7280;
  }
  .os-link {
    font-size: 16px;
    font-weight: 500;
    color: #16a34a;
  }

  .os-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 40px;
    text-align: center;
  }
  .os-foot-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .os-cta {
    padding: 18px 40px;
    font-size: 17px;
    cursor: pointer;
  }
  .os-cta.gl-btn-ghost-green { padding: 16px 36px; }
  .os-foot-note {
    font-size: 14px;
    color: #64748b;
  }
  .os-foot-link {
    font-size: 16px;
    font-weight: 500;
    color: #16a34a;
    text-decoration: none;
  }
  .os-foot-link:hover { color: #15803d; }

  @media (max-width: 639px) {
    .os-title { font-size: 21px; }
  }
</style>
