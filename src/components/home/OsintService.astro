---
import { Image } from 'astro:assets';
import detectiveImg from '@assets/detective.webp';
import estafadorImg from '@assets/estafador.webp';
import abogadoImg from '@assets/ci-abogado.webp';

// Ciberinteligencia en la home: los tres servicios enlazan a su página.
// Legal: GreenLock no tiene licencia de detective. Esa palabra no puede
// aparecer en ningún texto visible ni en los alt (el nombre de archivo sí).
const items = [
  { title: 'Due diligence de empresa', desc: 'Revisamos a la otra empresa antes de que firmes, inviertas o reclames.', img: detectiveImg, href: '/ciberinteligencia/due-diligence-empresas' },
  { title: 'Rastreo de huella digital', desc: 'Quién está detrás de un perfil falso, una web fraudulenta o una estafa.', img: estafadorImg, href: '/ciberinteligencia/rastreo-huella-digital' },
  { title: 'Evidencia digital para juicio', desc: 'La prueba digital, preservada con método para el procedimiento.', img: abogadoImg, href: '/ciberinteligencia/evidencia-digital-juicio' },
];
---

<section id="osint" class="os">
  <div class="container-custom section-padding">

    <div class="mb-16 max-w-3xl">
      <p class="uppercase mb-4" style="color: #22c55e; font-size: clamp(1.25rem, 2.4vw, 1.625rem); font-weight: 700; letter-spacing: 0.04em;">
        Ciberinteligencia
      </p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark-900 mb-5 leading-tight">
        Antes de firmar, invertir o reclamar,<br/>
        <span style="color: #22c55e;">conoce con quién tratas.</span>
      </h2>
      <p class="text-lg text-dark-500 leading-relaxed">
        Y si ya hay conflicto, te entregamos la prueba. Inteligencia digital y evidencias con alcance y plazo cerrados.
      </p>
    </div>

    <div class="os-grid">
      {items.map((item) => (
        <a href={item.href} class="os-card">
          <span class="os-visual">
            <Image src={item.img} alt={item.title} width={180} densities={[1, 2]} class="os-img" loading="lazy" decoding="async" />
          </span>
          <span class="os-body">
            <span class="os-title">{item.title}</span>
            <span class="os-desc">{item.desc}</span>
            <span class="os-link">Ver servicio →</span>
          </span>
        </a>
      ))}
    </div>

    <div class="os-foot">
      <div class="os-foot-ctas">
        <a href="/ciberinteligencia" class="gl-btn-primary os-cta">Ver ciberinteligencia</a>
      </div>
      <a href="/ciberinteligencia/abogados" class="os-foot-link">¿Eres abogado? Servicio para despachos →</a>
    </div>

  </div>
</section>

<style>
  .os {
    background: #fff;
    border-top: 1px solid #eef0f2;
  }

  .os-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 24px;
  }

  .os-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    text-align: center;
    color: #111827;
    text-decoration: none;
    transition: transform 0.3s;
  }
  .os-card:hover { transform: translateY(-3px); }

  .os-visual {
    width: 100%;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 24px 16px;
  }
  .os-img {
    width: 180px;
    height: 180px;
    object-fit: contain;
  }

  .os-body {
    display: flex;
    flex-direction: column;
    padding: 0 16px 24px;
  }
  .os-title {
    margin-bottom: 10px;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
    color: #111827;
  }
  .os-desc {
    margin-bottom: 12px;
    font-size: 16.5px;
    line-height: 1.65;
    color: #6b7280;
  }
  .os-link {
    font-size: 16px;
    font-weight: 500;
    color: #16a34a;
  }

  .os-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 40px;
    text-align: center;
  }
  .os-foot-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .os-cta {
    padding: 18px 40px;
    font-size: 17px;
    cursor: pointer;
  }
  .os-foot-link {
    font-size: 16px;
    font-weight: 500;
    color: #16a34a;
    text-decoration: none;
  }
  .os-foot-link:hover { color: #15803d; }

  @media (max-width: 639px) {
    .os-title { font-size: 21px; }
  }
</style>
