---
// Las dos puertas de la home: cada visitante elige su camino. data-door indica a
// LeadModals qué contexto tiene (el pop up de informe solo aparece en el de empresa).
import { Image } from 'astro:assets';
import empresaImg from '@assets/mascota-empresa.webp';
import casoImg from '@assets/mascota-caso-personal.webp';
---

<section class="doors">
  <div class="container-custom doors-inner">
    <div class="doors-grid">
      <a href="#servicios" class="door" data-door="empresa">
        <Image src={empresaImg} alt="" height={140} densities={[1, 2]} class="door-img" loading="lazy" decoding="async" />
        <span class="door-title">¿Eres una empresa?</span>
      </a>
      <a href="#osint" class="door" data-door="caso">
        <Image src={casoImg} alt="" height={147} densities={[1, 2]} class="door-img" loading="lazy" decoding="async" />
        <span class="door-title">¿Tienes un caso para investigar digitalmente?</span>
      </a>
    </div>
    <a href="#partners" class="doors-partner">¿Eres MSSP, consultora o despacho? <span>Programa de Partners →</span></a>
  </div>
</section>

<style>
  .doors { background: #fff; }
  .doors-inner {
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: clamp(3.5rem, 6vw, 5rem);
  }
  .doors-grid {
    width: 100%;
    max-width: 880px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 16px;
  }
  .door {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 8px;
    text-align: center;
    text-decoration: none;
    transition: transform 0.3s;
  }
  .door:hover { transform: translateY(-4px); }
  .door-img {
    height: 140px;
    width: auto;
    max-width: 80%;
    margin-bottom: 6px;
    object-fit: contain;
  }
  .door-title {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: #030712;
  }
  .doors-partner {
    font-size: 16px;
    font-weight: 500;
    color: #334155;
    text-align: center;
    text-decoration: none;
    transition: color 0.2s;
  }
  .doors-partner:hover { color: #030712; }
  .doors-partner span { color: #16a34a; }
</style>
