---
import { Image } from 'astro:assets';
import heroImg from '@assets/Hero-GL.webp';
---

<section class="hero">
  <!-- Círculo blanco de fondo -->
  <div class="hero-circle" aria-hidden="true"></div>

  <div class="hero-content container-custom">
    <h1 class="hero-title">
      <span class="hero-accent">Ciber</span>seguridad y<br />
      <span class="hero-accent">ciber</span>inteligencia
      <span class="hero-title-soft">Ciberseguridad para proteger tu empresa e investigación digital para resolver cualquier caso, con un equipo de ciberexpertos.</span>
    </h1>

    <Image
      src={heroImg}
      alt="Mascota de GreenLock"
      width={630}
      class="hero-img"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #f3f4f6;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    /* El header es fijo: el padding superior deja sitio para él */
    padding-top: clamp(7rem, 10vw, 10rem);
    padding-bottom: clamp(3rem, 5vw, 4rem);
  }

  .hero-circle {
    position: absolute;
    left: 50%;
    top: 40%;
    width: min(900px, 130vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #fff;
  }

  .hero-content {
    position: relative;
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.75rem, 6.4vw, 6.25rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 700;
    color: #030712;
  }
  .hero-accent { color: #22c55e; }
  .hero-title-soft {
    display: block;
    margin-top: 0.25em;
    font-size: 0.36em;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 300;
    color: #64748b;
  }

  .hero-img {
    display: block;
    height: min(44vh, 500px);
    width: auto;
    max-width: 90%;
    margin: 8px 0 0;
    object-fit: contain;
  }
</style>
