---
import { Image } from 'astro:assets';
import heroImg from '@assets/Hero-GL.webp';
---

<section class="hero">
  <!-- Círculo blanco de fondo -->
  <div class="hero-circle" aria-hidden="true"></div>

  <div class="hero-content container-custom">
    <h1 class="hero-title">
      Protege tu empresa
      <span class="hero-title-soft">antes de perder dinero y clientes.</span>
    </h1>

    <Image
      src={heroImg}
      alt="Protección de ciberseguridad empresarial - GreenLock escudo de seguridad ofensiva"
      width={600}
      class="hero-img"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />

    <div class="hero-contact">
      <p class="hero-lead">
        ¿Te preocupa la seguridad de tu empresa y no sabes por dónde empezar? <strong>Hablemos, sin compromiso.</strong>
      </p>
      <button type="button" class="gl-btn-primary hero-cta" data-open="asesoria">
        Hablar con un experto →
      </button>
      <p class="hero-note">Te contactaremos en menos de 24 horas.</p>
    </div>

    <div class="hero-links">
      <a
        href="https://wa.me/34603358517?text=Hola%2C%20me%20interesa%20información%20sobre%20ciberseguridad%20para%20mi%20empresa" data-ref="WEB-HERO"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-link hero-link--wa"
      >
        Asesoramiento gratuito por WhatsApp
      </a>
      <a href="#servicios" class="hero-link">Cómo trabajamos ↓</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #f3f4f6;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    /* El header es fijo: el padding superior deja sitio para él */
    padding-top: clamp(7rem, 10vw, 10rem);
    padding-bottom: clamp(3rem, 5vw, 4rem);
  }

  .hero-circle {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(900px, 130vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #fff;
  }

  .hero-content {
    position: relative;
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(3rem, 7.6vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    font-weight: 700;
    color: #030712;
  }
  .hero-title-soft {
    display: block;
    margin-top: 0.2em;
    font-size: 0.4em;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 300;
    color: #64748b;
  }

  .hero-img {
    display: block;
    height: min(36vh, 400px);
    width: auto;
    max-width: 90%;
    margin: 4px 0 -6px;
    object-fit: contain;
  }

  .hero-contact {
    width: 100%;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .hero-lead {
    margin: 0;
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    line-height: 1.5;
    color: #334155;
    text-wrap: balance;
  }
  .hero-lead strong {
    color: #030712;
    font-weight: 700;
  }

  .hero-cta {
    padding: 20px 40px;
    font-size: 19px;
    cursor: pointer;
  }
  .hero-cta,
  .hero-cta:hover {
    box-shadow: 0 20px 40px -20px rgba(22, 163, 74, 0.7);
  }

  .hero-note {
    margin: 0;
    font-size: 14px;
    color: #64748b;
  }

  .hero-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 28px;
    font-size: 16.5px;
    font-weight: 500;
  }
  .hero-link {
    color: #334155;
    text-decoration: none;
    transition: color 0.2s;
  }
  .hero-link:hover { color: #030712; }
  .hero-link--wa { color: #16a34a; }
  .hero-link--wa:hover { color: #15803d; }
</style>
