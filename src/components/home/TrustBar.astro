---
import { Image } from 'astro:assets';
import logoMitre from '@assets/icons/Mitre.webp';
import logoOwasp from '@assets/icons/owasp.webp';
import logoNis2 from '@assets/icons/NIS2.webp';
import logoEns from '@assets/icons/ENS.webp';
import logoIso from '@assets/icons/iso2001-logo.webp';
import logoIncibe from '@assets/icons/incibe.webp';

const frameworks = [
  { name: 'MITRE ATT&CK', logo: logoMitre, h: 24 },
  { name: 'OWASP', logo: logoOwasp, h: 36 },
  { name: 'NIS2', logo: logoNis2, h: 34 },
  { name: 'ENS', logo: logoEns, h: 34 },
  { name: 'ISO 27001', logo: logoIso, h: 34 },
  { name: 'INCIBE', logo: logoIncibe, h: 28 },
];
---

<section class="bg-white" style="padding-top: 40px; padding-bottom: 40px;">
  <div class="container-custom">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-dark-400 mb-6 text-center">
      Metodologías y marcos con los que trabajamos
    </p>
    <div class="fw-row">
      {frameworks.map((fw) => (
        <Image
          src={fw.logo}
          alt={fw.name}
          height={fw.h}
          densities={[1, 2]}
          class="fw-logo"
          style={`height: ${fw.h}px;`}
          loading="lazy"
        />
      ))}
    </div>
  </div>
</section>

<style>
  .fw-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2.5rem 4rem;
  }
  .fw-logo {
    width: auto;
    opacity: 0.6;
    user-select: none;
  }
</style>
