---
import { Image } from 'astro:assets';
import imgPerimetral from '@assets/perimetral.webp';
import imgRedTeam from '@assets/red-team.webp';
import img360 from '@assets/360.webp';
import imgContinua from '@assets/continua-robot.png';

const services = [
  {
    title: 'Auditoría Perimetral',
    description: 'Análisis exhaustivo de tu superficie de ataque externa. Identificamos cada punto de entrada antes que los atacantes.',
    icon: imgPerimetral,
  },
  {
    title: 'Red Team',
    description: 'Simulación de ataque real end-to-end. OSINT, ingeniería social, acceso físico y movimiento lateral sin restricciones.',
    icon: imgRedTeam,
    // El arte de Red Team ocupa más lienzo: lo escalamos algo por debajo del resto.
    iconScale: 0.83,
  },
  {
    title: 'Pentesting',
    description: 'Explotación controlada de aplicaciones web, APIs e infraestructura interna. Hallazgos priorizados y reproducibles.',
    icon: img360,
  },
  {
    title: 'Ciberseguridad Continua',
    description: 'Revisamos y auditamos tus sistemas de forma continua para que estés protegido en todo momento, no solo el día de la auditoría.',
    icon: imgContinua,
  },
];
---

<section id="servicios" class="bg-white">
  <div class="container-custom section-padding">

    <!-- Title + description -->
    <div class="mb-16 max-w-3xl">
      <p class="uppercase mb-4" style="color: #22c55e; font-size: clamp(1.25rem, 2.4vw, 1.625rem); font-weight: 700; letter-spacing: 0.04em;">
        Servicios de ciberseguridad
      </p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark-900 mb-5 leading-tight">
        Tu negocio <span style="color: #22c55e;">genera dinero.</span><br/>
        GreenLock lo mantiene <span style="color: #22c55e;">seguro.</span>
      </h2>
      <p class="text-lg text-dark-500 leading-relaxed">
        Ofrecemos servicios integrales de ciberseguridad que van más allá de la auditoría: identificamos riesgos reales, te asesoramos para mitigarlos y formamos a tu equipo.
      </p>
    </div>

    <!-- Services grid -->
    <div class="svc-grid">
      {services.map((service) => (
        <div class="svc-card">
          <div class="svc-icon-area">
            <Image src={service.icon} alt={service.title} width={180} height={180} class="svc-icon-img" loading="eager" decoding="async" style={service.iconScale ? `--svc-icon-scale: ${service.iconScale};` : ''} />
          </div>
          <div class="svc-content">
            <h3 class="svc-title">{service.title}</h3>
            <p class="svc-desc">{service.description}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    /* Tamaño base del icono; cada breakpoint lo redefine y las tarjetas que
       lo necesiten aplican su propia --svc-icon-scale encima. */
    --svc-icon-base: 180px;
  }

  .svc-card {
    display: flex;
    flex-direction: column;
    cursor: default;
    transition: transform 0.3s ease;
  }
  .svc-card:hover {
    transform: translateY(-3px);
  }

  .svc-icon-area {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 24px 16px;
    height: 220px;
  }

  .svc-icon-img {
    width: calc(var(--svc-icon-base) * var(--svc-icon-scale, 1));
    height: calc(var(--svc-icon-base) * var(--svc-icon-scale, 1));
    object-fit: contain;
    transition: transform 0.3s ease;
  }
  .svc-card:hover .svc-icon-img {
    transform: scale(1.06);
  }

  .svc-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 16px 24px;
  }

  .svc-title {
    font-size: 20px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .svc-desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: #6b7280;
  }

  @media (max-width: 639px) {
    .svc-grid {
      grid-template-columns: 1fr;
      gap: 16px;
      --svc-icon-base: 140px;
    }
  }

  /* Cuatro tarjetas: en tablet van en dos filas de dos. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .svc-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      --svc-icon-base: 150px;
    }
    .svc-icon-area {
      height: 190px;
      padding: 16px 8px 12px;
    }
    .svc-content {
      padding: 0 8px 20px;
    }
  }
</style>
