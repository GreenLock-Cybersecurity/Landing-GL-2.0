---
import { Image } from 'astro:assets';
import FeaturedService from '@components/pages/FeaturedService.astro';
import { servicesIn, serviceHref, type Service } from '@data/services';

// Tamaño de la ilustración en las tarjetas de la home (algunas mascotas traen más margen)
const CARD_SIZE: Record<string, { w: number; h: number; scale?: number }> = {
  'red-team': { w: 150, h: 150 },
  'pentest-aplicaciones': { w: 180, h: 180, scale: 1.45 },
  'pentest-wordpress': { w: 180, h: 180, scale: 1.45 },
  'concienciacion-phishing': { w: 354, h: 226 },
};
const cards = (group: 'auditoria' | 'formacion') =>
  servicesIn(group).map((s: Service) => ({ ...s, size: CARD_SIZE[s.slug] ?? { w: 180, h: 180 } }));
---

<section id="servicios" class="bg-white">
  <div class="container-custom section-padding">

    <!-- Title + description -->
    <div class="mb-16 max-w-3xl">
      <p class="uppercase mb-4" style="color: #22c55e; font-size: clamp(1.25rem, 2.4vw, 1.625rem); font-weight: 700; letter-spacing: 0.04em;">
        Ciberseguridad
      </p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark-900 mb-5 leading-tight">
        Tu negocio <span style="color: #22c55e;">genera dinero.</span><br/>
        GreenLock lo mantiene <span style="color: #22c55e;">seguro.</span>
      </h2>
      <p class="text-lg text-dark-500 leading-relaxed">
        Ofrecemos servicios integrales de ciberseguridad que van más allá de la auditoría: identificamos riesgos reales, te asesoramos para mitigarlos y formamos a tu equipo.
      </p>
    </div>

    <FeaturedService withButton />

    {[
      { group: 'auditoria' as const, title: 'Auditoría y pruebas de seguridad', text: 'Buscamos tus puntos débiles antes que los atacantes.', min: 300 },
      { group: 'formacion' as const, title: 'Formación', text: 'Tu equipo, la primera línea de defensa.', min: 260 },
    ].map((block) => (
      <>
        <div class="svc-group">
          <h3 class="svc-group-title">{block.title}</h3>
          <p class="svc-group-text">{block.text}</p>
        </div>
        <div class="svc-grid" style={`--svc-min: ${block.min}px;`}>
          {cards(block.group).map((service) => (
            <a href={serviceHref(service.slug)} class="svc-card">
              <div class="svc-icon-area">
                <Image
                  src={service.card.img.src}
                  alt={service.name}
                  width={service.size.w}
                  densities={[1, 2]}
                  class="svc-icon-img"
                  loading="lazy"
                  decoding="async"
                  style={`width: ${service.size.w}px; height: ${service.size.h}px;${service.size.scale ? ` transform: scale(${service.size.scale});` : ''}`}
                />
              </div>
              <div class="svc-content">
                <h3 class="svc-title">{service.name}</h3>
                <p class="svc-desc">{service.homeText ?? service.card.text}</p>
              </div>
            </a>
          ))}
        </div>
      </>
    ))}

    <div class="svc-foot">
      <button type="button" class="gl-btn-primary svc-cta" data-open="auditoria" data-opt="6">Solicitar asesoramiento</button>
      <p class="svc-foot-note">Te contactaremos en menos de 24 horas.</p>
      <a href="/ciberseguridad" class="svc-foot-link">Ver todos los servicios de ciberseguridad →</a>
    </div>

  </div>
</section>

<style>
  .svc-group {
    max-width: 760px;
    margin: 64px 0 8px;
  }
  .svc-group-title {
    margin-bottom: 8px;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    color: #0f172a;
  }
  .svc-group-text {
    font-size: 17px;
    line-height: 1.6;
    color: #64748b;
  }

  .svc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--svc-min)), 1fr));
    gap: 24px;
  }

  .svc-card {
    display: flex;
    flex-direction: column;
    color: #111827;
    text-decoration: none;
    transition: transform 0.3s ease;
  }
  .svc-card:hover {
    transform: translateY(-3px);
  }

  .svc-icon-area {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 24px 16px;
    height: 220px;
  }

  .svc-icon-img {
    max-width: 100%;
    object-fit: contain;
  }

  .svc-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 16px 24px;
  }

  .svc-title {
    font-size: 24px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .svc-desc {
    font-size: 16.5px;
    line-height: 1.65;
    color: #6b7280;
  }

  .svc-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 40px;
    text-align: center;
  }
  .svc-cta {
    padding: 18px 40px;
    font-size: 17px;
    cursor: pointer;
  }
  .svc-foot-note {
    font-size: 14px;
    color: #64748b;
  }
  .svc-foot-link {
    font-size: 16px;
    font-weight: 500;
    color: #16a34a;
    text-decoration: none;
  }
  .svc-foot-link:hover { color: #15803d; }

  @media (max-width: 639px) {
    .svc-title { font-size: 21px; }
  }
</style>
