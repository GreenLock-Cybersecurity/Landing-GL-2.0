---
// Sección para captar partners (MSSP, consultoras tecnológicas, compliance y
// derecho digital) que quieran ofrecer nuestros servicios a sus clientes.
import { Image } from 'astro:assets';
import msspImg from '@assets/partner-mssp.png';
import consultoriaImg from '@assets/partner-consultoria.png';
import complianceImg from '@assets/partner-compliance.png';

const profiles = [
  {
    title: 'MSSP y proveedores IT',
    desc: 'Añade pentesting, Red Team y ciberseguridad continua a tu oferta gestionada sin montar un equipo ofensivo propio.',
    img: msspImg,
  },
  {
    title: 'Consultoría tecnológica',
    desc: 'Incorpora nuestros servicios de ciberseguridad a tu catálogo y ofrécelos a tus clientes con tu marca, sin ampliar tu equipo.',
    img: consultoriaImg,
  },
  {
    title: 'Compliance y derecho digital',
    desc: 'NIS2, ENS, ISO 27001 o peritajes OSINT: aporta la evidencia técnica que tus informes y expedientes necesitan.',
    img: complianceImg,
  },
];

const benefits = [
  'Ejecutamos nosotros; la relación con el cliente sigue siendo tuya.',
  'Informes claros, listos para presentar a dirección o a un regulador.',
  'Condiciones de partner y respuesta en menos de 24 h.',
];

const ctaHref =
  'https://wa.me/34603358517?text=Hola%2C%20me%20gustar%C3%ADa%20ser%20partner%20de%20GreenLock%20y%20ofrecer%20vuestros%20servicios%20a%20mis%20clientes';
---

<section id="partners" class="bg-[#f3f4f6]">
  <div class="container-custom" style="padding-top: 6rem; padding-bottom: 6rem;">

    <div class="mb-16 max-w-3xl mx-auto text-center">
      <p class="uppercase mb-4" style="color: #22c55e; font-size: clamp(1.25rem, 2.4vw, 1.625rem); font-weight: 700; letter-spacing: 0.04em;">
        Programa de Partners
      </p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark-900 mb-5 leading-tight">
        Ofrece ciberseguridad a tus clientes <span style="color: #22c55e;">sin montar un equipo.</span>
      </h2>
      <p class="text-lg text-dark-500 leading-relaxed">
        Si eres MSSP, consultora tecnológica o despacho de compliance y derecho digital, incorpora nuestros servicios a tu catálogo. Tú mantienes la relación con tu cliente; nosotros ponemos el equipo técnico.
      </p>
    </div>

    <div class="pt-grid">
      {profiles.map((p) => (
        <div class="pt-card">
          <Image src={p.img} alt="" height={250} densities={[1, 2]} class="pt-img" loading="lazy" decoding="async" />
          <h3 class="pt-title">{p.title}</h3>
          <p class="pt-desc">{p.desc}</p>
        </div>
      ))}
    </div>

    <ul class="pt-benefits">
      {benefits.map((b) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
          <span>{b}</span>
        </li>
      ))}
    </ul>

    <div class="pt-foot">
      <div class="pt-ctas">
        <button type="button" class="gl-btn-primary pt-cta" data-open="partner">
          Quiero ser partner
        </button>
        <a href={ctaHref} data-ref="WEB-PARTNER" target="_blank" rel="noopener noreferrer" class="gl-btn-ghost pt-cta pt-cta--ghost">
          Contáctanos
        </a>
      </div>
      <p class="pt-foot-note">Te respondemos en menos de 24 h con las condiciones del programa.</p>
    </div>

  </div>
</section>

<style>
  .pt-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .pt-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 32px 24px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0;
    transition: border-color 0.25s ease;
  }
  .pt-card:hover { border-color: #22c55e; }

  .pt-img {
    width: 220px;
    height: 250px;
    object-fit: contain;
    margin: -12px 0 12px;
  }

  .pt-title {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 8px;
  }
  .pt-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: #6b7280;
  }

  .pt-benefits {
    list-style: none;
    margin: 40px auto 0;
    padding: 0;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pt-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15.5px;
    line-height: 1.55;
    color: #374151;
  }
  .pt-benefits svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    color: #16a34a;
  }

  .pt-foot {
    text-align: center;
    margin-top: 44px;
  }
  .pt-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .pt-cta {
    padding: 16px 32px;
    font-size: 16px;
    white-space: nowrap;
    cursor: pointer;
  }
  .pt-cta--ghost { padding: 14px 32px; }
  .pt-foot-note {
    margin-top: 14px;
    font-size: 13.5px;
    color: #6b7280;
  }

  @media (max-width: 1023px) {
    .pt-grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
