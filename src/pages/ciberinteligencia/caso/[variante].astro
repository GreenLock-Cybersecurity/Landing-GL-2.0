---
// Landing de Google Ads para investigación digital: una variante por grupo de
// anuncios (/ciberinteligencia/caso/<variante>) para que el mensaje case con el
// anuncio. noindex y fuera del sitemap. El formulario va directo al Worker
// (/lead/osint) con la variante, el gclid y las UTM.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import LandingLayout from '@layouts/LandingLayout.astro';
import { LEAD_LIMITS } from '@lib/leads';
import logoImg from '@assets/icons/Logo.webp';
import casoImg from '@assets/mascota-caso-personal.webp';
import detectiveImg from '@assets/detective.webp';
import suplantacionImg from '@assets/mascota-suplantacion.webp';
import estafadorImg from '@assets/estafador.webp';
import periciaImg from '@assets/mascota-informe-pericial.webp';
import perfilImg from '@assets/mascota-perfil-falso.webp';
import acosoImg from '@assets/mascota-acoso.webp';
import complianceImg from '@assets/partner-compliance.webp';
import paso1Img from '@assets/ads-paso-1.webp';
import paso2Img from '@assets/ads-paso-2.webp';
import damianImg from '@assets/damian.webp';
import diegoImg from '@assets/diego.webp';
import hacknetImg from '@assets/HackNet-Logo.webp';
import crtoImg from '@assets/crto.webp';
import uneonImg from '@assets/uneon.webp';

// Casos que se pueden marcar. `option` = índice en LEAD_OPTIONS.osint (el valor que acepta el Worker).
const CASES: { id: string; label: string; img: ImageMetadata; scale: number; option: number }[] = [
  { id: 'perfil', label: 'Perfil falso o suplantación', img: perfilImg, scale: 1.5, option: 1 },
  { id: 'acoso', label: 'Acoso o difamación', img: acosoImg, scale: 1.5, option: 3 },
  { id: 'quien', label: '¿Quién está detrás?', img: detectiveImg, scale: 1, option: 2 },
  { id: 'estafa', label: 'Estafa online', img: estafadorImg, scale: 1, option: 0 },
  { id: 'juicio', label: 'Prueba para un juicio', img: complianceImg, scale: 1.4, option: 3 },
];

const VARIANTS = {
  generica: { h1: 'Investigación digital', sub: 'Seguimos el rastro que deja en internet quien está detrás de tu caso y lo convertimos en prueba.', img: casoImg, scale: 1, caso: null },
  quien: { h1: '¿Quién está detrás de esa cuenta?', sub: 'Seguimos su rastro y lo convertimos en prueba.', img: detectiveImg, scale: 1.1, caso: 'quien' },
  suplantacion: { h1: '¿Alguien se hace pasar por ti?', sub: 'Preservamos la prueba y seguimos el rastro del perfil falso.', img: suplantacionImg, scale: 1.5, caso: 'perfil' },
  estafa: { h1: '¿Te han estafado por internet?', sub: 'Convertimos el rastro en pruebas para tu denuncia.', img: estafadorImg, scale: 1.1, caso: 'estafa' },
  juicio: { h1: '¿Necesitas pruebas para el juicio?', sub: 'Informe pericial ratificable ante el juez.', img: periciaImg, scale: 1.4, caso: 'juicio' },
} as const;

type VariantKey = keyof typeof VARIANTS;

export function getStaticPaths() {
  return (['generica', 'quien', 'suplantacion', 'estafa', 'juicio'] as const).map((variante) => ({ params: { variante } }));
}

const key = Astro.params.variante as VariantKey;
const v = VARIANTS[key];
const defaultCase = CASES.find((c) => c.id === v.caso) ?? null;
const wa = 'https://wa.me/34603358517?text=Hola%2C%20quiero%20contaros%20mi%20caso';
const waRef = `ADS-OSINT-${key}`;

const FAQS = [
  ['¿Vale un WhatsApp o una captura como prueba?', 'Una captura sola es fácil de impugnar. Preservamos el contenido con método (fecha, origen y huella digital) y lo documentamos en un informe pericial para que tenga más peso.'],
  ['¿Es legal lo que hacéis?', 'Sí. Trabajamos solo con fuentes abiertas e información pública, conforme al RGPD.'],
  ['¿Me diréis quién es?', 'No prometemos identificar a nadie. Seguimos el rastro y documentamos todo lo que encontramos; con ese informe, tu abogado o la policía pueden pedir al juez los datos que faltan.'],
  ['¿Recuperaréis mi dinero?', 'No. Nuestro trabajo es convertir el rastro en prueba para tu denuncia. La recuperación depende del procedimiento y de tu banco.'],
  ['¿Cuánto cuesta y cuánto tarda?', 'La primera valoración es gratuita. [Precio orientativo y plazo habitual según el tipo de caso].'],
  ['¿Es confidencial?', 'Sí. Solo el equipo que lleva tu caso ve tu información. [Referencia a la política de privacidad].'],
];
---

<LandingLayout title="Investigación digital confidencial | GreenLock" description={`${v.h1} ${v.sub}`}>
  <div class="ads" data-ads data-variante={key} data-case={defaultCase?.id ?? ''} data-option={defaultCase?.option ?? 3} data-case-label={defaultCase?.label ?? ''}>

    <header class="ads-header">
      <div class="ads-wrap ads-header-inner">
        <span class="ads-logo">
          <Image src={logoImg} alt="GreenLock" width={30} height={30} class="ads-logo-img" loading="eager" />
          <span>Green<span class="ads-logo-accent">Lock</span></span>
        </span>
        <a href={wa} data-ref={waRef} target="_blank" rel="noopener noreferrer" class="ads-header-wa"><span class="ads-wa-dot" aria-hidden="true"></span>WhatsApp</a>
      </div>
    </header>

    <!-- Hero + formulario -->
    <section class="ads-hero">
      <div class="ads-hero-circle" aria-hidden="true"></div>
      <div class="ads-wrap ads-hero-grid">
        <div class="ads-hero-copy">
          <p class="ads-kicker">Investigación digital · OSINT</p>
          <h1 class="ads-h1">{v.h1}</h1>
          <p class="ads-sub">{v.sub}</p>
          <div class="ads-hero-extra">
            <ul class="ads-bullets">
              <li>Informe pericial con cadena de custodia</li>
              <li>Solo fuentes abiertas (OSINT), conforme al RGPD</li>
              <li>Equipo de ciberexpertos con nombre y cara</li>
            </ul>
            <div class="ads-hero-mascot">
              <Image src={v.img} alt="Mascota de GreenLock" height={220} densities={[1, 2]} class="ads-hero-img" loading="eager" decoding="async" style={`--s: ${v.scale};`} />
              <p class="ads-hero-urgency">Cuanto antes actúes, más rastro queda. <span>→</span></p>
            </div>
          </div>
        </div>

        <div id="form" class="ads-form-card" data-ads-form-box>
          <form class="ads-form" data-ads-form data-astro-reload>
            <input class="ads-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="ads-form-head">
              <p class="ads-form-title">Cuéntanos tu caso</p>
              <span class="ads-form-case" data-ads-case-label>{defaultCase ? `Caso: ${defaultCase.label}` : ''}</span>
            </div>
            <input class="ads-input" name="name" required maxlength={LEAD_LIMITS.name} placeholder="Nombre" aria-label="Nombre" autocomplete="name" data-ads-first />
            <input class="ads-input" name="email" type="email" required maxlength={LEAD_LIMITS.email} placeholder="Email" aria-label="Email" autocomplete="email" />
            <input class="ads-input" name="phone" type="tel" required maxlength={LEAD_LIMITS.phone} placeholder="Teléfono" aria-label="Teléfono" autocomplete="tel" />
            <textarea class="ads-input ads-textarea" name="message" rows="2" required maxlength="900" placeholder="Cuéntanos en 2 líneas qué ha pasado" aria-label="Cuéntanos en 2 líneas qué ha pasado"></textarea>
            <button type="submit" class="gl-btn-primary ads-submit">Contar mi caso →</button>
            <p class="ads-error" role="alert" hidden>No se ha podido enviar. Inténtalo de nuevo o escríbenos por WhatsApp.</p>
            <p class="ads-reassure">Valoración gratuita · Sin compromiso · Confidencial · Respuesta en menos de 24 h</p>
            <div class="ads-team">
              <span class="ads-team-faces">
                <Image src={damianImg} alt="" width={34} height={34} densities={[1, 2]} class="ads-face" loading="lazy" />
                <Image src={diegoImg} alt="" width={34} height={34} densities={[1, 2]} class="ads-face" loading="lazy" />
              </span>
              <span>Te atienden <strong>Damián Pérez</strong> y <strong>Diego Rodríguez</strong>, nuestro equipo de ciberexpertos</span>
            </div>
            <a href={wa} data-ref={waRef} target="_blank" rel="noopener noreferrer" class="ads-form-wa">¿Prefieres escribirnos? WhatsApp →</a>
            <p class="ads-privacy">Al enviar aceptas la <a href="/legal/privacidad" target="_blank" rel="noopener">política de privacidad</a>. Responsable: GreenLock Cybersecurity E.S.P.J. Finalidad: responder a tu solicitud.</p>
          </form>
          <div class="ads-done" data-ads-done tabindex="-1" hidden>
            <span class="ads-done-check" aria-hidden="true">✓</span>
            <p class="ads-done-title">Caso recibido</p>
            <p class="ads-done-text">Te llamamos en menos de 24 horas. Mientras tanto, no borres nada.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ¿Te suena? -->
    <section class="ads-section">
      <div class="ads-wrap">
        <h2 class="ads-h2">Situaciones que investigamos en internet</h2>
        <div class="ads-quotes">
          <p>“Hay un perfil con mis fotos y no sé quién es.”</p>
          <p>“Me amenazan desde una cuenta anónima.”</p>
          <p>“Denuncié y me dicen que se archiva porque no saben quién es.”</p>
        </div>
        <div class="ads-inline-cta">
          <p>Detrás de cada caso hay <strong>un rastro</strong>. Lo seguimos y lo convertimos en prueba.</p>
          <button type="button" class="gl-btn-primary ads-btn" data-ads-to-form>Contar mi caso</button>
        </div>
      </div>
    </section>

    <!-- Cómo funciona -->
    <section class="ads-section ads-section--gray">
      <div class="ads-wrap">
        <h2 class="ads-h2">Cómo es una investigación digital</h2>
        <div class="ads-steps">
          {[
            { img: paso1Img, title: 'Nos cuentas el caso', text: 'Por el formulario o por WhatsApp. Te llamamos en menos de 24 h.' },
            { img: paso2Img, title: 'Preservamos la prueba y seguimos el rastro', text: 'Guardamos las evidencias antes de que desaparezcan y analizamos fuentes abiertas.' },
            { img: periciaImg, title: 'Recibes un informe pericial', text: 'Para tu denuncia o para que tu abogado lo aporte en el juicio.' },
          ].map((step) => (
            <div class="ads-step">
              <div class="ads-step-visual">
                <Image src={step.img} alt="" height={190} densities={[1, 2]} class="ads-step-img" loading="lazy" decoding="async" />
              </div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- HackNet y equipo -->
    <section class="ads-section">
      <div class="ads-wrap ads-community">
        <div class="ads-people">
          <div class="ads-person">
            <Image src={diegoImg} alt="Diego Rodríguez Sanz" width={160} height={160} densities={[1, 2]} class="ads-person-img" loading="lazy" />
            <div class="ads-person-body">
              <Image src={hacknetImg} alt="HackNet" width={56} height={56} class="ads-person-badge ads-person-badge--round" loading="lazy" />
              <span class="ads-person-big">100.000+</span>
              <span class="ads-person-accent">seguidores en redes sociales</span>
              <span class="ads-person-role">Diego Rodríguez · Cofundador · HackNet</span>
            </div>
          </div>
          <div class="ads-person ads-person--rule">
            <Image src={damianImg} alt="Damián Pérez Moreno" width={160} height={160} densities={[1, 2]} class="ads-person-img" loading="lazy" />
            <div class="ads-person-body">
              <Image src={crtoImg} alt="CRTO" width={56} height={56} class="ads-person-badge" loading="lazy" />
              <span class="ads-person-big ads-person-big--sm">Certificación CRTO</span>
              <span class="ads-person-accent">Certified Red Team Operator</span>
              <span class="ads-person-role">Damián Pérez · Cofundador · Seguridad ofensiva</span>
            </div>
          </div>
        </div>
        <div class="ads-community-copy">
          <h2 class="ads-h2 ads-h2--tight">Nos sigue una comunidad de <span>más de 100.000 personas</span></h2>
          <p>Diego Rodríguez, cofundador de GreenLock, divulga ciberseguridad y OSINT en HackNet, su canal de YouTube. Lo que enseñamos en abierto es lo que aplicamos en tu caso.</p>
          <div><button type="button" class="gl-btn-primary ads-btn" data-ads-to-form>Contar mi caso</button></div>
        </div>
      </div>
    </section>

    <!-- Casos -->
    <section class="ads-section">
      <div class="ads-wrap">
        <h2 class="ads-h2 ads-h2--flush">¿Qué necesitas investigar?</h2>
        <p class="ads-lead">Pulsa el tuyo y empieza.</p>
        <div class="ads-cases">
          {CASES.map((c) => (
            <button type="button" class="ads-case" data-ads-pick={c.id} data-option={c.option} data-label={c.label}>
              <span class="ads-case-visual">
                <Image src={c.img} alt="" height={130} densities={[1, 2]} class="ads-case-img" loading="lazy" decoding="async" style={`transform: scale(${c.scale});`} />
              </span>
              <span class="ads-case-label">{c.label}</span>
              <span class="ads-case-link">Es mi caso →</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Por qué nosotros -->
    <section class="ads-section ads-section--dark">
      <div class="ads-wrap">
        <h2 class="ads-h2 ads-h2--light">Por qué investigar con <span>GreenLock</span></h2>
        <div class="ads-why">
          <div><h3>No nos quedamos en la captura</h3><p>Una captura la hace cualquiera. Nosotros seguimos el rastro que hay detrás.</p></div>
          <div><h3>Pensamos como el atacante</h3><p>Venimos de la seguridad ofensiva: sabemos cómo se esconde quien está al otro lado.</p></div>
          <div><h3>Lo explicamos en abierto</h3><p>Divulgamos ciberseguridad y OSINT en HackNet, con más de 100.000 seguidores en redes sociales.</p></div>
        </div>
      </div>
    </section>

    <!-- Confianza -->
    <section class="ads-section">
      <div class="ads-wrap ads-trust">
        <figure class="ads-quote">
          <span class="ads-quote-mark" aria-hidden="true">“</span>
          <blockquote>Lo que primero me sorprendió de GreenLock fue su capacidad de prevenir situaciones. Son la nueva generación de ciberexpertos que controlan el medio, los nuevos ataques y, por su capacidad, deberían tener sedes en todo el mundo. Juventud y talento son las dos grandes virtudes de estos grandes profesionales. Mi experiencia en el análisis con fuentes abiertas ha sido abrumadora y espectacular, tanto, que estoy recomendando a mis clientes y partners que los conozcan y, una vez dada la oportunidad, estoy seguro de que no se separarán de ellos.</blockquote>
          <figcaption>
            <Image src={uneonImg} alt="Uneon" height={34} densities={[1, 2]} class="ads-quote-logo" loading="lazy" />
            <span class="ads-quote-who"><strong>Rafael Gimeno</strong><span>CEO, Uneon · Despacho de abogados (Derecho Informático)</span></span>
          </figcaption>
        </figure>
        <div class="ads-trust-side">
          <div class="ads-trust-team">
            <div class="ads-trust-member">
              <Image src={damianImg} alt="Damián Pérez Moreno" width={64} height={64} densities={[1, 2]} class="ads-trust-face" loading="lazy" />
              <div><p class="ads-trust-name">Damián Pérez Moreno</p><p class="ads-trust-role">Seguridad ofensiva · CRTO</p></div>
            </div>
            <div class="ads-trust-member">
              <Image src={diegoImg} alt="Diego Rodríguez Sanz" width={64} height={64} densities={[1, 2]} class="ads-trust-face" loading="lazy" />
              <div><p class="ads-trust-name">Diego Rodríguez Sanz</p><p class="ads-trust-role">Ingeniería de seguridad · HackNet</p></div>
            </div>
          </div>
          <p class="ads-trust-note">[Cifra real: casos o informes realizados] · [Precio orientativo tras la valoración gratuita]</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="ads-section ads-section--gray">
      <div class="ads-wrap ads-wrap--narrow">
        <h2 class="ads-h2">Preguntas frecuentes</h2>
        <div class="ads-faqs">
          {FAQS.map(([q, a]) => (
            <details class="ads-faq">
              <summary><span>{q}</span><span class="ads-faq-icon" aria-hidden="true"></span></summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section class="ads-final">
      <div class="ads-wrap ads-final-grid">
        <div class="ads-final-copy">
          <h2>Cuanto antes actúes, <span>más rastro queda.</span></h2>
          <p>Los perfiles se borran y los mensajes desaparecen. Cuéntanoslo hoy.</p>
        </div>
        <div class="ads-form-card ads-form-card--flat" data-ads-form-box>
          <form class="ads-form" data-ads-form data-astro-reload>
            <input class="ads-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input class="ads-input" name="name" required maxlength={LEAD_LIMITS.name} placeholder="Nombre" aria-label="Nombre" autocomplete="name" />
            <input class="ads-input" name="email" type="email" required maxlength={LEAD_LIMITS.email} placeholder="Email" aria-label="Email" autocomplete="email" />
            <input class="ads-input" name="phone" type="tel" required maxlength={LEAD_LIMITS.phone} placeholder="Teléfono" aria-label="Teléfono" autocomplete="tel" />
            <textarea class="ads-input ads-textarea" name="message" rows="2" required maxlength="900" placeholder="Cuéntanos en 2 líneas qué ha pasado" aria-label="Cuéntanos en 2 líneas qué ha pasado"></textarea>
            <button type="submit" class="gl-btn-primary ads-submit">Contar mi caso →</button>
            <p class="ads-error" role="alert" hidden>No se ha podido enviar. Inténtalo de nuevo o escríbenos por WhatsApp.</p>
            <p class="ads-reassure">Valoración gratuita · Sin compromiso · Confidencial · Respuesta en menos de 24 h</p>
            <p class="ads-privacy">Al enviar aceptas la <a href="/legal/privacidad" target="_blank" rel="noopener">política de privacidad</a>. Responsable: GreenLock Cybersecurity E.S.P.J. Finalidad: responder a tu solicitud.</p>
          </form>
          <p class="ads-done-inline" data-ads-done hidden>✓ Caso recibido. Te llamamos en menos de 24 h.</p>
        </div>
      </div>
      <p class="ads-legal">
        © {new Date().getFullYear()} GreenLock Cybersecurity E.S.P.J. · NIF E22754246 ·
        <a href="/legal/aviso-legal" target="_blank" rel="noopener">Aviso legal</a> ·
        <a href="/legal/cookies" target="_blank" rel="noopener">Cookies</a>
      </p>
    </section>

    <!-- Barra fija en móvil -->
    <div class="ads-bar" data-ads-bar>
      <button type="button" class="gl-btn-primary ads-bar-cta" data-ads-to-form>Contar mi caso</button>
      <a href={wa} data-ref={waRef} target="_blank" rel="noopener noreferrer" class="ads-bar-wa" aria-label="WhatsApp">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      </a>
    </div>
  </div>
</LandingLayout>

<script>
  import { submitLead } from '@lib/leads';

  const root = document.querySelector<HTMLElement>('[data-ads]');
  if (root) {
    const variante = root.dataset.variante || 'generica';
    const formBox = document.getElementById('form');
    const caseLabel = root.querySelector<HTMLElement>('[data-ads-case-label]');
    let sent = false;

    const toForm = () => {
      if (!formBox) return;
      window.scrollTo({ top: formBox.getBoundingClientRect().top + window.scrollY - 12, behavior: 'smooth' });
      window.setTimeout(() => root.querySelector<HTMLElement>('[data-ads-first]')?.focus({ preventScroll: true }), 450);
    };

    root.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-ads-to-form]')) { toForm(); return; }
      const pick = target.closest<HTMLElement>('[data-ads-pick]');
      if (pick) {
        root.dataset.case = pick.dataset.adsPick;
        root.dataset.option = pick.dataset.option;
        root.dataset.caseLabel = pick.dataset.label;
        if (caseLabel) caseLabel.textContent = `Caso: ${pick.dataset.label}`;
        toForm();
      }
    });

    root.querySelectorAll<HTMLFormElement>('[data-ads-form]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (form.dataset.sending || sent) return;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const error = form.querySelector<HTMLElement>('.ads-error');
        const label = button?.textContent ?? '';
        form.dataset.sending = '1';
        if (button) { button.disabled = true; button.textContent = 'Enviando…'; }
        if (error) error.hidden = true;

        const data = new FormData(form);
        const value = (k: string) => String(data.get(k) ?? '').trim();
        const prefix = root.dataset.caseLabel ? `[${root.dataset.caseLabel}] ` : '';
        const ok = await submitLead('osint', {
          name: value('name'),
          email: value('email'),
          phone: value('phone'),
          message: prefix + value('message'),
          website: value('website'),
          variante,
        }, Number(root.dataset.option ?? 3));

        delete form.dataset.sending;
        if (button) { button.disabled = false; button.textContent = label; }
        if (!ok) { if (error) error.hidden = false; return; }

        // Enviado: ambos formularios muestran el mensaje de éxito y la barra móvil desaparece
        sent = true;
        root.classList.add('is-sent');
        root.querySelectorAll<HTMLElement>('[data-ads-form]').forEach((f) => { f.hidden = true; });
