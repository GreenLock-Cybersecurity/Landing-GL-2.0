---
// Hub de Ciberinteligencia: tres servicios (due diligence, rastreo, evidencia) y despachos.
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/pages/PageHero.astro';
import IntelSections from '@components/intel/IntelSections.astro';
import { intelHub, intelImage, PHONE, PHONE_HREF } from '@data/intel';

const page = intelHub();
const hero = page.hero;
---

<BaseLayout title={page.seo.title} exactTitle description={page.seo.description} schemas={page.seo.jsonld}>
  <div data-servicio={page.form.slug}>
    <PageHero
      crumbs={hero.crumbs}
      eyebrow={hero.eyebrow}
      title={hero.h1}
      sub={hero.sub}
      primary={hero.cta}
      img={intelImage(hero.img)}
      tel={{ text: 'Le llamamos en menos de 24 h hábiles:', label: PHONE, href: PHONE_HREF }}
    />
    <IntelSections page={page} />
  </div>
</BaseLayout>
