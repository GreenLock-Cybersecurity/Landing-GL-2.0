---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import HomeDoors from '@components/home/HomeDoors.astro';
import ServicesGrid from '@components/home/ServicesGrid.astro';
import CaseStudyHighlight from '@components/home/CaseStudyHighlight.astro';
import OsintService from '@components/home/OsintService.astro';
import Team from '@components/home/Team.astro';
import BlogRecent from '@components/home/BlogRecent.astro';
import TrustBar from '@components/home/TrustBar.astro';
import FinalCTA from '@components/home/FinalCTA.astro';
import PartnerSection from '@components/home/PartnerSection.astro';
import LeadModals from '@components/home/LeadModals.astro';

// Service structured data for SEO
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://greenlock.tech/#services',
  name: 'GreenLock Cybersecurity',
  url: 'https://greenlock.tech',
  provider: { '@id': 'https://greenlock.tech/#organization' },
  areaServed: { '@type': 'Country', name: 'España' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de Ciberseguridad',
    itemListElement: [
      ['Ciberseguridad gestionada', 'Medidas de protección a medida, protección de equipos y webs y vigilancia constante para pymes.'],
      ['Auditoría de ciberseguridad perimetral', 'Análisis exhaustivo de tu superficie de ataque externa. Identificamos cada punto de entrada antes que los atacantes.'],
      ['Pentesting de aplicaciones web e infraestructura', 'Explotación controlada de aplicaciones web, APIs, apps móviles e infraestructura, con hallazgos priorizados y reproducibles.'],
      ['Red Team', 'Simulación de ataque real de principio a fin que pone a prueba tus defensas, procesos y equipo de respuesta.'],
      ['Ciberseguridad ofensiva continua', 'Atacamos tus sistemas de forma periódica, como lo haría un atacante real, para encontrar nuevas brechas antes que nadie.'],
      ['Concienciación y phishing simulado', 'Formación y campañas de phishing simulado para reducir el riesgo humano.'],
      ['Investigación OSINT e informe pericial', 'Seguimos el rastro digital de estafas, suplantaciones y cuentas anónimas y lo convertimos en un informe pericial.'],
      ['Informe gratuito de exposición digital', 'Análisis gratuito de las principales exposiciones de tu negocio en internet.'],
    ].map(([name, description]) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name, description },
    })),
  },
};
---

<BaseLayout
  title="GreenLock | Auditoría de ciberseguridad, pentesting e investigación OSINT para empresas"
  description="Auditoría de ciberseguridad, pentesting y red team para pymes y empresas en España. Investigación OSINT de estafas y suplantación de marca con informe pericial. Informe de exposición digital gratuito."
  schemas={[serviceSchema]}
>
  <Hero />
  <HomeDoors />
  <CaseStudyHighlight />
  <ServicesGrid />
  <OsintService />
  <PartnerSection />
  <TrustBar />
  <Team />
  <BlogRecent />
  <FinalCTA />
  <LeadModals />
</BaseLayout>
