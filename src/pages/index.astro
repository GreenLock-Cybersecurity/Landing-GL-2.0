---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import ServicesGrid from '@components/home/ServicesGrid.astro';
import CaseStudyHighlight from '@components/home/CaseStudyHighlight.astro';
import OsintService from '@components/home/OsintService.astro';
import Team from '@components/home/Team.astro';
import BlogRecent from '@components/home/BlogRecent.astro';
import TrustBar from '@components/home/TrustBar.astro';
import FinalCTA from '@components/home/FinalCTA.astro';
import PartnerSection from '@components/home/PartnerSection.astro';
import LeadModals from '@components/home/LeadModals.astro';

// Service structured data for SEO
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://greenlock.tech/#services',
  name: 'GreenLock Cybersecurity',
  url: 'https://greenlock.tech',
  provider: { '@id': 'https://greenlock.tech/#organization' },
  areaServed: { '@type': 'Country', name: 'España' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de Ciberseguridad',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Auditoría Perimetral',
          description: 'Análisis exhaustivo de tu superficie de ataque externa. Identificamos vulnerabilidades antes que los atacantes.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Red Team',
          description: 'Simulaciones de ataque realistas que ponen a prueba tus defensas, procesos y equipo de respuesta.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Pentesting',
          description: 'Explotación controlada de aplicaciones web, APIs e infraestructura interna, con hallazgos priorizados y reproducibles.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Ciberseguridad Continua',
          description: 'Revisión y auditoría continua de los sistemas del cliente para mantenerlos protegidos de forma permanente.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Investigación OSINT e informe pericial',
          description: 'Identificamos quién está detrás de estafas, marcas falsas y cuentas anónimas, con un informe pericial listo para denunciar.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Informe gratuito de exposición digital',
          description: 'Análisis gratuito de las principales exposiciones de tu negocio en internet.',
        },
      },
    ],
  },
};
---

<BaseLayout
  title="GreenLock | Auditoría de ciberseguridad, pentesting e investigación OSINT para empresas"
  description="Auditoría de ciberseguridad, pentesting y red team para pymes y empresas en España. Investigación OSINT de estafas y suplantación de marca con informe pericial. Informe de exposición digital gratuito."
  schemas={[serviceSchema]}
>
  <Hero />
  <CaseStudyHighlight />
  <ServicesGrid />
  <OsintService />
  <PartnerSection />
  <TrustBar />
  <Team />
  <BlogRecent />
  <FinalCTA />
  <LeadModals />
</BaseLayout>
